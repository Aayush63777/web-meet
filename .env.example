# QuickMeet Environment Configuration
# Copy this file to .env and update with your settings

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server port
PORT=3000

# Node environment (development, production, test)
NODE_ENV=development

# Enable debug mode (shows detailed logs)
DEBUG=false

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Maximum participants allowed per room
MAX_PARTICIPANTS=200

# Application name
APP_NAME=QuickMeet

# Application description
APP_DESCRIPTION=Professional Video Conferencing Platform

# ============================================
# WEBRTC CONFIGURATION
# ============================================

# STUN server for NAT traversal
# Default: stun:stun.stunprotocol.org
# You can use multiple: stun:stun1.l.google.com:19302, stun:stun2.l.google.com:19302
STUN_SERVER=stun:stun.stunprotocol.org

# TURN server (optional, for relaying through firewall)
# TURN_SERVER=turn:turnserver.example.com:3478
# TURN_USERNAME=username
# TURN_PASSWORD=password

# ============================================
# LOGGING & MONITORING
# ============================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable request logging
LOG_REQUESTS=false

# Enable socket event logging
LOG_SOCKET_EVENTS=false

# ============================================
# SECURITY
# ============================================

# CORS origin (comma-separated if multiple)
CORS_ORIGIN=http://localhost:3000

# Enable HTTPS (set to true in production)
ENABLE_HTTPS=false

# Session secret (for session management, if implemented)
# Generate a strong value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ============================================
# DATABASE (For future use)
# ============================================

# Database URL (when implementing persistence)
# DATABASE_URL=mongodb://localhost:27017/quickmeet

# ============================================
# DEPLOYMENT
# ============================================

# Deployment environment (local, docker, vercel, heroku, aws)
DEPLOYMENT_ENV=local

# Public URL (for generating shareable links)
PUBLIC_URL=http://localhost:3000

# ============================================
# FEATURE FLAGS
# ============================================

# Enable experimental features
ENABLE_EXPERIMENTAL=false

# Enable analytics
ENABLE_ANALYTICS=false

# Enable error reporting
ENABLE_ERROR_REPORTING=false

# ============================================
# NOTES
# ============================================

# 1. Never commit .env file to git
#    It's listed in .gitignore for security
#
# 2. Create .env from .env.example
#    cp .env.example .env
#
# 3. Update values as needed for your environment
#
# 4. For production deployment:
#    - Set NODE_ENV=production
#    - Use secure CORS_ORIGIN
#    - Enable HTTPS
#    - Change SESSION_SECRET
#    - Use production STUN/TURN servers
#    - Set DEBUG=false
#
# 5. For Docker deployment:
#    - Pass environment variables via docker run -e
#    - Or use .env file in docker container
#
# 6. For Vercel deployment:
#    - Set environment variables in Vercel dashboard
#    - Not through .env file
